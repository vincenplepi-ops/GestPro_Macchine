{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/_next/static/chunks/page-(.*)\\.js",
      "dest": "/api/chunk?chunk=page-$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "https://gestpro-macchine-mobile.plepivincens.chatgpt.site/$1"
    }
  ]
}
